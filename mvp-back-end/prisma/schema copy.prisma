datasource db {
  provider = "sqlite" // simples para MVP, pode trocar para Postgres depois
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Trilha {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String
  imagens     String // array de URLs ou base64
}